            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"]
            },
            "description": "Creates a new collaborative room, assigns caller as host, and stores the generated roomId in collection variables."
