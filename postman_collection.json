  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005/admin/api/v1",
      "type": "string",
      "description": "Base URL of the API. Default is http://localhost:3005/admin/api/v1 (or http://localhost:3000 if running without service prefix)."
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Stateless JWT access token populated automatically by Login/Register test scripts."
    },
    {
      "key": "roomId",
      "value": "",
      "type": "string",
      "description": "Active MongoDB Room ID populated automatically by Create Room test script."
    }
  ],
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has success true and accessToken\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data).to.have.property('accessToken');",
                  "});",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set(\"token\", res.data.accessToken);",
                  "    console.log(\"[Postman] JWT saved to collection variable 'token'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Developer\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new user account with hashed password and returns a JWT access token."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has success true and accessToken\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data).to.have.property('accessToken');",
                  "});",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set(\"token\", res.data.accessToken);",
                  "    console.log(\"[Postman] JWT saved to collection variable 'token'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates user credentials and sets the JWT access token in the collection variable 'token'."
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints for user registration and login."
    },
    {
      "name": "USERS",
      "item": [
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User profile returned without password\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data).to.have.property('email');",
                  "    pm.expect(res.data).to.not.have.property('password');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Fetches the profile of the currently authenticated user using the Bearer token."
          },
          "response": []
        }
      ],
      "description": "User profile management endpoints."
    },
    {
      "name": "ROOMS",
      "item": [
        {
          "name": "Create Room",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Room created with status ACTIVE\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data.status).to.eql('ACTIVE');",
                  "});",
                  "if (res.data && (res.data.id || res.data._id)) {",
                  "    const id = res.data.id || res.data._id;",
                  "    pm.collectionVariables.set(\"roomId\", id);",
                  "    console.log(\"[Postman] Room ID saved to collection variable 'roomId': \" + id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sprint Planning & Retrospective\",\n  \"password\": \"room-secret-123\"\n}"
